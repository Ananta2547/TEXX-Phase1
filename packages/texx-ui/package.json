{
  "name": "@texx/ui",
  "version": "0.1.0",
  "private": true,
  "description": "TEXX design system — React component library built from the Phase 1 site's own patterns",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/texx-ui.css"
  },
  "files": ["dist", "fonts"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "node build.mjs",
    "fonts": "node scripts/extract-fonts.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.23.1"
  }
}
